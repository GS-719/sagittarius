[Unit]
Description=Sagittarius VMTouch Core Library Lock
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'vmtouch -dl /usr/lib/libvulkan.so* /usr/lib/libwayland-client.so* $([ -d /usr/lib/wine ] && echo /usr/lib/wine) 2>/dev/null || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
