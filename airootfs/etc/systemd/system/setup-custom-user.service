[Unit]
Description=Setup Sagittarius User for Greetd
Before=greetd.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c "id -u sagittarius &>/dev/null || useradd -m -G wheel,video,audio,input,render sagittarius; echo 'sagittarius:sagittarius' | chpasswd"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
