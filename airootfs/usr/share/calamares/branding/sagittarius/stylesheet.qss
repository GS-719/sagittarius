QWidget {
    background-color: #050505;
    color: #EAEAEA;
    font-family: sans-serif;
}

#stepL {
    /* Sidebar styling */
    background-color: #050505;
    border-right: 1px solid #1A1A1A;
}

QPushButton {
    background-color: #0B0B0B;
    border: 1px solid #1A1A1A;
    padding: 6px 20px;
    color: #EAEAEA;
}

QPushButton:hover {
    border: 1px solid #7C4DFF;
    background-color: #1A1A1A;
}

QProgressBar {
    border: 1px solid #1A1A1A;
    background-color: #0B0B0B;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #7C4DFF;
}
